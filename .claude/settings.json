{
  "attribution": {
    "commit": ""
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "16000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "NO_COLOR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest *)",
      "Bash(npx tsx scripts/*)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(node scripts/*)",
      "Bash(node -e *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files*)",
      "PowerShell(npm run *)",
      "PowerShell(npm test*)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx tsx scripts/*)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx eslint *)",
      "PowerShell(node scripts/*)",
      "PowerShell(node -e *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git ls-files*)"
    ],
    "deny": [
      "Read(dist/**)",
      "Read(coverage/**)",
      "Read(test-output/**)",
      "Read(package-lock.json)",
      "Read(node_modules/**)",
      "Read(tests/_fixtures/tool-shape*.json)",
      "Read(tests/_fixtures/samples.sha256.json)",
      "Bash(npm publish*)",
      "Bash(npm unpublish*)",
      "Bash(npm deprecate*)",
      "Bash(npm dist-tag*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr close*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr comment*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue comment*)",
      "Bash(gh release *)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method DELETE*)",
      "PowerShell(npm publish*)",
      "PowerShell(npm unpublish*)",
      "PowerShell(npm deprecate*)",
      "PowerShell(npm dist-tag*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push *)",
      "PowerShell(git push)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr edit*)",
      "PowerShell(gh pr close*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh pr comment*)",
      "PowerShell(gh issue create*)",
      "PowerShell(gh issue edit*)",
      "PowerShell(gh issue close*)",
      "PowerShell(gh issue comment*)",
      "PowerShell(gh release *)",
      "PowerShell(gh api *--method POST*)",
      "PowerShell(gh api *--method PUT*)",
      "PowerShell(gh api *--method PATCH*)",
      "PowerShell(gh api *--method DELETE*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
