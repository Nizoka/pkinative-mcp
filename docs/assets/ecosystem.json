  "assertions": [
    {
      "id": "tool-count",
      "canonical": "{derived.tools} tools",
      "match": "(?<![#.\\d])(?<!\\b(?:on|across|among|within|for)\\s)(?<!\\b(?:on|across|among|within|for)\\sthe\\s)(?<!\\()\\b(\\d+)\\s+tools\\b",
