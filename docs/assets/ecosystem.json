    {
      "id": "engine-error-count",
      "canonical": "{declared.engineErrorCodes} `PKI_*` error codes",
      "match": "\\b(\\d+)\\s+`?PKI_\\*`?\\s+(?:error\\s+)?codes\\b",
      "expectFrom": "declared.engineErrorCodes",
      "requireIn": []
    },
    {
      "id": "engine-reason-count",
      "canonical": "{declared.engineReasonCodes} `PKI_REASON_*` verdict reasons",
      "match": "\\b(\\d+)\\s+`?PKI_REASON_\\*`?\\s+(?:verdict\\s+)?(?:reasons|codes)\\b",
      "expectFrom": "declared.engineReasonCodes",
      "requireIn": []
    },
    {
      "id": "engine-diagnostic-count",
      "canonical": "{declared.engineDiagnosticCodes} `PKI_DIAG_*` diagnostics",
      "match": "\\b(\\d+)\\s+`?PKI_DIAG_\\*`?\\s+(?:diagnostics|diagnostic codes|codes)\\b",
      "expectFrom": "declared.engineDiagnosticCodes",
      "requireIn": []
    },
    {
      "id": "env-var-count",
      "canonical": "{derived.envVars} environment variables",
      "match": "\\b(\\d+)\\s+(?:environment|operator)\\s+variables\\b",
      "expectFrom": "derived.envVars",
